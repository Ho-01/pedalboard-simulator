{
  "name": "pedalboard-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "npm run typecheck && vite build && node scripts/version.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "playwright test",
    "simulate:verify": "node --import tsx scripts/simulation/verify.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@playwright/test": "^1.56.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "vite": "8.3.3"
  }
}
